      "parameters": {
        "jsCode": "const incidents = items;\n\nconst issueCount = {};\nconst networkCount = {};\nconst interfaceCount = {};\n\nlet criticalCount = 0;\n\nfor (const item of incidents) {\n\n  const issue = item.json[\"Issue Type\"];\n  const network = item.json[\"Network Element\"];\n  const iface = item.json[\"Interface\"]; // Important: use your actual column name\n  const severity = item.json[\"Severity\"];\n\n  issueCount[issue] = (issueCount[issue] || 0) + 1;\n  networkCount[network] = (networkCount[network] || 0) + 1;\n  interfaceCount[iface] = (interfaceCount[iface] || 0) + 1;\n\n  if (severity === \"Critical\") {\n    criticalCount++;\n  }\n}\n\nfunction topKey(obj) {\n  return Object.keys(obj).reduce((a, b) =>\n    obj[a] > obj[b] ? a : b\n  );\n}\n\nreturn [{\n  json: {\n    topIssue: topKey(issueCount),\n    topNetworkElement: topKey(networkCount),\n    topInterface: topKey(interfaceCount),\n    criticalIncidents: criticalCount\n  }\n}];"
      },
